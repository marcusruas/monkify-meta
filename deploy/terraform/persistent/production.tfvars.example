# Copy to production.auto.tfvars.json (generated by the deploy tool from secrets.<env>.json)
# or production.tfvars, then `terraform apply -var-file=...`. Placeholders only.
project_id        = "your-gcp-project-id"
region            = "us-central1"
dns_zone_name     = "chimpout-zone"
dns_domain        = "chimpout.com."
state_bucket_name = "chimpout-tfstate-your-gcp-project-id"
labels = {
  app        = "chimpout"
  managed_by = "terraform"
}

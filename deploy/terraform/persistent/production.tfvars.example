# PERSISTENT layer variables, per environment. Copy to <environment>.tfvars — the name the
# deploy tool looks for (production.tfvars, development.tfvars) — and fill it in. Placeholders only;
# the real files are git-ignored.
#
# Every name here is ENVIRONMENT-SCOPED, because development and production share one GCP project:
#   dns_zone_name      spacestroker-<envCode>-zone
#   state_bucket_name  spacestroker-tfstate-<envCode>-<projectId>      (must match the tool's derivation)
#
# protect_persistent = true  -> production: teardown keeps this layer (the domain survives).
# protect_persistent = false -> development: teardown destroys this layer too (TOTAL teardown).
project_id         = "your-gcp-project-id"
region             = "us-central1"
dns_zone_name      = "spacestroker-prod-zone"
dns_domain         = "spacestroker.com."
state_bucket_name  = "spacestroker-tfstate-prod-your-gcp-project-id"
protect_persistent = true
labels = {
  app         = "spacestroker"
  managed_by  = "terraform"
  environment = "production"
}

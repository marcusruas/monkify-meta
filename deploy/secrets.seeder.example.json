{
  // The Space Stroker API. Production: https://api.spacestroker.com
  "apiBaseUrl": "https://api.spacestroker.com",

  // Base58 secret key (64 bytes) of the wallet that places the seeded bets.
  //
  // MUST NOT be the operator's token-owner / treasury wallet: a transfer from that wallet to
  // itself confirms as a no-op, so every bet would be rejected as underpaid AFTER the money moved.
  // The app checks this at startup and refuses to run.
  //
  // Needs the game token (for the stakes) and a little SOL (for transaction fees).
  "walletPrivateKeyBase58": "REPLACE_ME",

  // Display name shown next to the seeded bet in the live bets feed and the history page.
  "displayName": "REPLACE_ME",

  // Hours between seeding passes. The first pass runs immediately on start.
  "intervalHours": 6,

  // Bounded retry inside a pass, for transient failures BEFORE any transfer is sent.
  // A sent transfer is NEVER re-sent, whatever these are set to.
  "retryAttempts": 3,
  "retryBaseDelaySeconds": 5,

  // How long to poll for a sent transfer's confirmation before giving up on it.
  "confirmTimeoutSeconds": 90
}

# Local secrets — the operator's source of truth. NEVER commit (only the template is tracked).
secrets*.json
!secrets.example.json

# Terraform working files + state + real variable files
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
# Generated by the deploy tool from secrets.<env>.json
*.auto.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .NET build output for the console apps
**/bin/
**/obj/

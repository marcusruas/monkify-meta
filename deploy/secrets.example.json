{
  "_comment": "TEMPLATE ONLY — placeholders. Copy to secrets.<env>.json (git-ignored), fill real values there. Never commit real secrets. See README.md → 'Environments' and 'Secrets to replace for production'.",
  "_comment_environment": "'environment' is LOAD-BEARING: it yields the env code (development->dev, production->prod) that prefixes every project-global GCP id and names the per-environment state bucket. Teardown destroys the WORKLOAD layer only for EVERY environment (the DNS zone + state bucket are always preserved — they cost almost nothing to keep); a non-production 'teardown --purge' ALSO destroys the DNS zone + state bucket + sweeps secrets (production forbids --purge). Run 'spacestroker-deploy validate' to see every derived id.",
  "environment": "production",

  "gcp": {
    "projectId": "your-gcp-project-id",
    "region": "us-central1",
    "dnsZoneName": "spacestroker-prod-zone",
    "dnsDomain": "spacestroker.com.",
    "domains": {
      "api": "api.spacestroker.com",
      "app": "app.spacestroker.com",
      "lp": "spacestroker.com",
      "lpWww": "www.spacestroker.com"
    },
    "consumerCount": 1,
    "apiMinInstances": 1,
    "apiMaxInstances": 10,
    "enableDeletionProtection": true,
    "dbInstanceSuffix": ""
  },

  "secrets": {
    "ConnectionStrings:SpaceStroker": "Host=REPLACE_ME;Port=5432;Database=spacestroker;Username=spacestroker_app;Password=REPLACE_ME",
    "ConnectionStrings:Messaging": "Host=REPLACE_ME;Port=5432;Database=spacestroker_messaging;Username=spacestroker_app;Password=REPLACE_ME",
    "ConnectionStrings:Redis": "REPLACE_ME_redis_host:6379,password=REPLACE_ME",
    "GeneralSettings:Token:TokenOwnerPrivateKey": "REPLACE_ME_solana_owner_private_key",
    "GeneralSettings:LaunchTokens:MainSigningPrivateKeyPem": "REPLACE_ME_pem_private_key",
    "GeneralSettings:SecretProtection:Key": "REPLACE_ME_aes_key",
    "GeneralSettings:Fx:ApiKey": "REPLACE_ME_freecurrencyapi_key",
    "GeneralSettings:Token:ClusterUrl": "https://mainnet.helius-rpc.com/?api-key=REPLACE_ME_helius_api_key"
  },

  "_comment_clusterUrl": "GeneralSettings:Token:ClusterUrl is a SECRET, not appConfig: the RPC provider's api-key rides in the URL's query string, and appConfig entries become plaintext Cloud Run env vars. Devnet form: https://devnet.helius-rpc.com/?api-key=... The FALLBACK below is a plain public endpoint with no key, so it stays in appConfig.",

  "appConfig": {
    "ASPNETCORE_ENVIRONMENT": "Production",
    "GeneralSettings:Token:FallbackClusterUrl": "https://api.mainnet-beta.solana.com/",
    "GeneralSettings:Token:MintAddress": "REPLACE_ME",
    "GeneralSettings:Token:SenderAccount": "REPLACE_ME",
    "GeneralSettings:Token:TokenOwnerPublicKey": "REPLACE_ME",
    "GeneralSettings:Token:Decimals": 6,
    "GeneralSettings:LaunchTokens:MainOperatorPublicKeyPem": "REPLACE_ME_pem_public_key",
    "GeneralSettings:Cors:AllowedOrigins:0": "https://app.spacestroker.com"
  },

  "frontBuild": {
    "VUE_APP_API_BASE_URL": "https://api.spacestroker.com",
    "VUE_APP_WEBSOCKET_BASE_URL": "https://api.spacestroker.com/Hubs",
    "VUE_APP_SOLANA_NETWORK": "mainnet-beta",
    "VUE_APP_USDC_TOKEN_ADDRESS": "REPLACE_ME",
    "VUE_APP_GAME_TOKEN_ADDRESS": "REPLACE_ME",
    "VUE_APP_ALLOW_FREE_BETS": "false",
    "VUE_APP_IDLE_DISCONNECT_HIDDEN_MS": "1800000",
    "VUE_APP_IDLE_DISCONNECT_INACTIVE_MS": "3600000",
    "VUE_APP_SOLANA_PROXY_URL": "https://api.spacestroker.com/rpc",
    "VUE_APP_SOLANA_CONFIRM_TIMEOUT_MS": "45000",
    "VUE_APP_SOLANA_CONFIRM_POLL_INTERVAL_MS": "1000",
    "VUE_APP_BALANCE_POLL_INTERVAL_MS": "30000"
  }
}

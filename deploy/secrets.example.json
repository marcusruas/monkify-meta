{
  "_comment": "TEMPLATE ONLY — placeholders. Copy to secrets.<env>.json (git-ignored), fill real values there. Never commit real secrets. See README.md → 'Secrets to replace for production'.",
  "environment": "production",

  "gcp": {
    "projectId": "your-gcp-project-id",
    "region": "us-central1",
    "stateBucket": "spacestroker-tfstate-your-gcp-project-id",
    "dnsZoneName": "spacestroker-zone",
    "dnsDomain": "spacestroker.com.",
    "domains": {
      "api": "api.spacestroker.com",
      "app": "app.spacestroker.com",
      "lp": "spacestroker.com",
      "lpWww": "www.spacestroker.com"
    },
    "consumerCount": 1,
    "apiMinInstances": 1,
    "apiMaxInstances": 10,
    "enableDeletionProtection": true
  },

  "secrets": {
    "ConnectionStrings:SpaceStroker": "Host=REPLACE_ME;Port=5432;Database=spacestroker;Username=spacestroker_app;Password=REPLACE_ME",
    "ConnectionStrings:Messaging": "Host=REPLACE_ME;Port=5432;Database=spacestroker_messaging;Username=spacestroker_app;Password=REPLACE_ME",
    "ConnectionStrings:Redis": "REPLACE_ME_redis_host:6379,password=REPLACE_ME",
    "GeneralSettings:Token:TokenOwnerPrivateKey": "REPLACE_ME_solana_owner_private_key",
    "GeneralSettings:LaunchTokens:MainSigningPrivateKeyPem": "REPLACE_ME_pem_private_key",
    "GeneralSettings:SecretProtection:Key": "REPLACE_ME_aes_key",
    "GeneralSettings:Fx:ApiKey": "REPLACE_ME_freecurrencyapi_key"
  },

  "appConfig": {
    "ASPNETCORE_ENVIRONMENT": "Production",
    "GeneralSettings:Token:ClusterUrl": "https://api.mainnet-beta.solana.com/",
    "GeneralSettings:Token:MintAddress": "REPLACE_ME",
    "GeneralSettings:Token:SenderAccount": "REPLACE_ME",
    "GeneralSettings:Token:TokenOwnerPublicKey": "REPLACE_ME",
    "GeneralSettings:Token:Decimals": 6,
    "GeneralSettings:LaunchTokens:MainOperatorPublicKeyPem": "REPLACE_ME_pem_public_key",
    "GeneralSettings:Cors:AllowedOrigins:0": "https://app.spacestroker.com"
  },

  "frontBuild": {
    "VUE_APP_API_BASE_URL": "https://api.spacestroker.com",
    "VUE_APP_WEBSOCKET_BASE_URL": "https://api.spacestroker.com/Hubs",
    "VUE_APP_SOLANA_NETWORK": "mainnet-beta",
    "VUE_APP_USDC_TOKEN_ADDRESS": "REPLACE_ME",
    "VUE_APP_GAME_TOKEN_ADDRESS": "REPLACE_ME",
    "VUE_APP_ALLOW_FREE_BETS": "false",
    "VUE_APP_DEV_LAUNCH": "false"
  }
}
